# Proxy API (force to override function routes)
/px          /.netlify/functions/px          200!
/suggestions /.netlify/functions/suggestions 200!

# Static pages
/blackmarket /blackmarket.html                200
/market      /market.html                     200
/market/     /market.html                     200

# Browsers ask for /favicon.ico by default; point at the real icon
/favicon.ico /icon-192.png                    301

# SPA catch-all — serve index.html for routes without a real file
/*           /index.html                      200
