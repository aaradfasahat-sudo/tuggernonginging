rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'fasahatalhasan@gmail.com';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /players/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isAdmin() || isOwner(uid);
      allow delete: if isAdmin();
    }

    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isAdmin();
    }

    match /posts/{docId} {
      allow read: if isAdmin() || request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin() || request.auth.uid == resource.data.authorUid;
      allow delete: if isAdmin();

      // ── Post comments ──────────────────────────────────────
      match /comments/{commentId} {
        allow read: if isAdmin() || request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isAdmin() || request.auth.uid == resource.data.authorUid;
        allow delete: if isAdmin();
      }
    }

    match /conversations/{convId} {
      allow read: if isAdmin()
        || (request.auth != null
            && request.auth.uid in resource.data.participants);
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow update: if isAdmin()
        || (request.auth != null
            && request.auth.uid in resource.data.participants);
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAdmin()
          || (request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants);
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /feature_suggestions/{docId} {
      allow read: if isAdmin() || request.auth != null;
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /channels/{channelId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
